# ─────────────────────────────────────────────────────────────────────────────
# Bricks Backend API — environment template
# Copy to .env.local and fill in what you use. Anything left blank is skipped.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web Search Providers (/api/search) ───────────────────────────────────────
# Falls back to free DuckDuckGo scraping if none are set.
SERPER_API_KEY=
TINYFISH_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=

# ── Serverless Page Fetcher (/api/fetch-page) ────────────────────────────────
# TinyFish — Free tier search & fetch/scrape (uses TINYFISH_API_KEY above)
# Diffbot — 10,000 free requests/month (Smart AI extraction)
DIFFBOT_TOKEN=
# scrape.do — 1,000 free requests/month  https://scrape.do
SCRAPE_DO_KEY=
# Scrapfly — 200 free requests/month  https://scrapfly.io
SCRAPFLY_KEY=
# Firecrawl — 500 free total credits  https://firecrawl.dev
FIRECRAWL_KEY=
# ScraperAPI — last-resort fallback in /api/reader when Puppeteer fails
SCRAPER_API_KEY=

# ── /api/reader Feature Flag ─────────────────────────────────────────────────
# "true" routes ALL /reader traffic through /fetch-page (no Puppeteer).
READER_USE_FETCH_PAGE="false"

# ── Email Validation Cascade (/api/validate-email) ───────────────────────────
HUNTER_KEY=
MILLION_VERIFIER_KEY=
QUICK_EMAIL_VERIFICATION_KEY=
BILLION_VERIFIER_KEY=
ZEROBOUNCE_KEY=
EMAILABLE_KEY=
REOON_API_KEY=
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=

# ── Puppeteer Settings ───────────────────────────────────────────────────────
# Max concurrent browser instances (default: 5)
PUPPETEER_MAX_BROWSERS=5
# Optional: path to a local Chromium binary. Commented = bundled Chromium.
# PUPPETEER_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ─────────────────────────────────────────────────────────────────────────────
# AI Waterfall Gateway (/api/ai/v1/*)
# OpenAI-compatible chat completions across free-tier providers.
# Priority order (lowest tried first):
#   1. Ollama  2. Nvidia NIM  3. Cloudflare  4. OpenRouter
#   5. Google AI Studio  6. Groq
# Leave a key blank to skip that provider entirely.
# ─────────────────────────────────────────────────────────────────────────────

# Waterfall mode:
#   stateful   (default) — in-memory health state; skips rate-limited providers
#   serverless           — dumb sequential; no state; safe for Vercel / Lambda
WATERFALL_MODE=stateful

# "true" also persists provider health to provider-health.json on disk
# (survives server restarts; only useful in stateful mode on a long-lived server)
WATERFALL_PERSIST_HEALTH=false

# 1. Ollama — your Ollama server URL (local or hosted). Free, no key required.
#    Leave blank to skip (provider is disabled when unset).
OLLAMA_BASE_URL=

# 2. Nvidia NIM — https://build.nvidia.com → sign in → get API key
#    Generous free tier for experimentation
NVIDIA_NIM_API_KEY=

# 3. Cloudflare AI Workers — https://dash.cloudflare.com → AI → Workers AI
#    Both values required.
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 4. OpenRouter — https://openrouter.ai → API keys
#    Aggregator with many free models (labelled :free on their site)
OPENROUTER_API_KEY=

# 5. Google AI Studio — https://aistudio.google.com → Get API key
#    Uses the OpenAI-compatible endpoint
GOOGLE_AI_STUDIO_API_KEY=

# 6. Groq — https://console.groq.com → API Keys
#    Very fast inference but low free-tier limits
GROQ_API_KEY=